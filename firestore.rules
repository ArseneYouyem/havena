rules_version = '2';

// Règles Firestore HAVENA.
// La collection `users` ne contient QUE la liaison compte Firebase Auth <-> rôle
// (uid, email, fullName, role, active, createdAt, createdBy). Les permissions
// elles-mêmes sont codées en dur côté app (lib/core/auth/role_permissions.dart),
// jamais éditables via Firestore.
//
// Déploiement : `firebase deploy --only firestore:rules` (nécessite `firebase login`).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isFondatrice() {
      return isSignedIn()
        && callerDoc().data.role == 'fondatrice'
        && callerDoc().data.active == true;
    }

    function isActiveUser() {
      return isSignedIn() && callerDoc().data.active == true;
    }

    match /users/{uid} {
      // Chacun peut lire son propre document (nécessaire au login / à la
      // synchronisation de session). La Fondatrice peut lire tous les comptes
      // (écran "Gestion des accès").
      allow read: if isSignedIn() && (request.auth.uid == uid || isFondatrice());

      // Seule la Fondatrice peut créer, modifier ou désactiver des comptes.
      // Un utilisateur ne peut jamais modifier son propre rôle.
      allow create: if isFondatrice();
      allow update: if isFondatrice() && request.auth.uid != uid;
      allow delete: if false; // désactiver (active: false) plutôt que supprimer
    }

    // Collections de synchronisation des données métier (voir
    // lib/core/sync/ : SyncEngine, EntitySyncAdapter par module). Tout
    // compte actif peut lire/écrire — le filtrage par rôle (Agent limité
    // aux inspections, etc.) reste appliqué côté app
    // (lib/core/auth/role_permissions.dart) : ces règles protègent contre
    // un client compromis qui contournerait l'UI, pas une reproduction
    // fine du tableau de permissions par rôle (jugé disproportionné pour
    // la taille de l'équipe visée — cahier des charges §20). La
    // suppression de document est bloquée : le modèle est en suppression
    // douce (`isDeleted`), une vraie suppression Firestore romprait la
    // synchronisation d'un appareil qui n'a pas encore vu le document.
    match /{collection}/{docId} {
      allow read, create, update: if isActiveUser() && collection in [
        'clients', 'logements', 'abonnements', 'interventions',
        'prestataires', 'finances', 'rapports', 'inspections',
        'calendrier_evenements'
      ];
      allow delete: if false;
    }

    // Toute autre collection future reste fermée par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
